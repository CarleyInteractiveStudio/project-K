# VGA Text Screen Driver Module

fnc screen_write_char(col, row, ch, color) {
    offset = (row * 80 + col) * 2
    addr = 0x000B8000 + offset
    mem_write(addr, ch)
    mem_write(addr + 1, color)
}

fnc screen_fill_color(color_attr) {
    row = 0
    while (row < 25) {
        col = 0
        while (col < 80) {
            screen_write_char(col, row, 32, color_attr)
            col = col + 1
        }
        row = row + 1
    }
}
