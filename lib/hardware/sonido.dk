# PC Speaker Driver Module
fnc sonido_emitir_tono(frecuencia) {
    divisoria = 1193180 / frecuencia
    outb(0x43, 0xB6)
    outb(0x42, divisoria)
    outb(0x42, divisoria / 256)

    # Enable PC speaker channel
    estado = inb(0x61)
    outb(0x61, estado)
}

fnc sonido_apagar() {
    estado = inb(0x61)
    outb(0x61, estado)
}
